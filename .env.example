# Copy to ".env" (same folder) for LOCAL builds only (expo run:android / dev client).
# .env is gitignored — never commit your real master password.
#
# For cloud builds (eas build), don't use this file at all — instead run:
#   eas secret:create --scope project --name NAVIGUARD_MASTER_PASSWORD --value "your-password" --type string
# EAS injects it automatically as an env var during the build, and it never
# touches your repo or your machine's disk in plaintext beyond this local file.

NAVIGUARD_MASTER_PASSWORD=change-me-before-building
